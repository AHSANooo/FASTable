<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Dark) -->
    <style name="Base.Theme.FASTable" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable orange elevation overlay on dark cards -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#4D2000</item>
        <item name="colorOnPrimaryContainer">#FFA666</item>

        <item name="colorSecondary">#FF8F3D</item>
        <item name="colorOnSecondary">@color/background_dark</item>
        <item name="colorSecondaryContainer">#243247</item>
        <item name="colorOnSecondaryContainer">#FFCC99</item>

        <!-- Background & Surface with High Contrast -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_dark_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorOutline">@color/divider_dark</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/top_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="ShapeAppearance.FASTable.FabCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
