<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light) -->
    <style name="Base.Theme.FASTable" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable orange elevation overlay on white cards -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- Brand Colors -->
        <item name="colorPrimary">@color/primary_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_orange_light</item>
        <item name="colorOnPrimaryContainer">@color/primary_orange_dark</item>

        <item name="colorSecondary">@color/top_bar_color</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#FFF3EB</item>
        <item name="colorOnSecondaryContainer">@color/top_bar_orange_dark</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorSurfaceVariant">#F1F5F9</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="colorOutline">@color/divider_light</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/top_bar_color</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.FASTable" parent="Base.Theme.FASTable" />

    <!-- Perfectly Circular Floating Action Button Style -->
    <style name="ShapeAppearance.FASTable.FabCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
