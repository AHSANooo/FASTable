<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/navy"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="?attr/homeAsUpIndicator" />

    <!-- Day Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:tabTextColor="#666"
        app:tabSelectedTextColor="#0A2E5D"
        app:tabIndicatorColor="#0A2E5D"
        app:tabMode="scrollable" />

    <!-- Room Type Tabs (Rooms / Labs) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutRoomType"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#FAFAFA"
        app:tabTextColor="#888"
        app:tabSelectedTextColor="#0A2E5D"
        app:tabIndicatorColor="#0A2E5D"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Loading Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        android:indeterminateTint="#0D2A5C" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No free rooms found"
        android:textSize="16sp"
        android:textColor="#666"
        android:textAlignment="center"
        android:padding="32dp"
        android:visibility="gone"
        android:lineSpacingExtra="4dp" />

    <!-- RecyclerView for Free Rooms -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFreeRooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>

