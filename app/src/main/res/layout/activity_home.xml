<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home">

    <!-- Main content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:background="@color/top_bar_color"
            android:elevation="4dp"
            android:paddingTop="28dp"
            android:paddingBottom="6dp"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/white"
            app:title="FASTable"
            app:titleCentered="true"
            app:titleTextColor="@color/white"
            app:menu="@menu/top_app_bar_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tab Layout for Today / All Timetable -->
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="?attr/colorSurface"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabToday"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Today"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/selected_tab_left"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@null"
                app:elevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabAllTimetable"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="All Timetable"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/unselected_tab_right"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@null"
                app:elevation="0dp"
                app:strokeWidth="0dp" />
        </LinearLayout>

        <!-- Container for Today View -->
        <ScrollView
            android:id="@+id/scrollViewToday"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="16dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/tabContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Current Day Header -->
                <TextView
                    android:id="@+id/tvCurrentDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monday"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium" />

                <!-- RecyclerView for Today's Sessions -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDashboardSessions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false" />

                <!-- Enhanced Empty State for Today -->
                <LinearLayout
                    android:id="@+id/layoutEmptyToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/app_logo"
                        android:alpha="0.8" />

                    <TextView
                        android:id="@+id/tvEmptyTitleToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Classes Today!"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvEmptySubtitleToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enjoy your day off, or add courses to build your schedule."
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textAlignment="center"
                        android:layout_marginTop="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddCoursesToday"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:text="Add Courses"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:cornerRadius="10dp"
                        app:backgroundTint="@color/primary_orange" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Container for All Timetable View -->
        <LinearLayout
            android:id="@+id/containerAllTimetable"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tabContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Day Tabs for All Timetable -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                app:tabTextColor="?attr/colorOnSurfaceVariant"
                app:tabSelectedTextColor="@color/primary_orange"
                app:tabIndicatorColor="@color/primary_orange"
                app:tabMode="scrollable" />

            <!-- RecyclerView for All Timetable Sessions -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAllTimetable"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:clipToPadding="false" />

            <!-- Empty State for All Timetable -->
            <LinearLayout
                android:id="@+id/layoutEmptyAll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/app_logo"
                    android:alpha="0.7" />

                <TextView
                    android:id="@+id/tvEmptyTitleAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Classes Scheduled"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvEmptySubtitleAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add your courses from Batch or Custom Timetable."
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textAlignment="center"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCoursesAll"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:text="Add Courses"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/primary_orange" />
            </LinearLayout>

        </LinearLayout>

                <!-- Refresh Timestamp Floating Pill -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pillRefreshStatus"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="17dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="@id/fabRefresh"
            app:layout_constraintBottom_toBottomOf="@id/fabRefresh"
            app:layout_constraintEnd_toStartOf="@id/fabRefresh">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/dotSyncStatus"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_dot_online" />

                <TextView
                    android:id="@+id/tvRefreshStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last synced just now"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Refresh Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Refresh timetable"
            android:src="@drawable/ic_refresh"
            app:backgroundTint="@color/primary_orange"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FASTable.FabCircle"
            app:layout_constraintBottom_toTopOf="@id/fabAddTimetable"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Add Timetable Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddTimetable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="Add courses"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/primary_orange"
            app:tint="@android:color/white"
            app:maxImageSize="34dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.FASTable.FabCircle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Full-screen Loading Overlay -->
        <FrameLayout
            android:id="@+id/loadingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#80000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/loading_dialog_bg"
                android:padding="24dp">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="@color/primary_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Refreshing schedule..."
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/drawerPane"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/top_bar_menu"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@color/top_bar_color"
            android:paddingTop="24dp"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/white"
            app:title="Menu"
            app:titleTextColor="@color/white"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/top_bar_menu"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Section -->
                <LinearLayout
                    android:id="@+id/profileSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/profileImage"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_profile_placeholder"
                        app:civ_border_width="2dp"
                        app:civ_border_color="@color/primary_orange" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Student"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="student@isb.nu.edu.pk"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/colorOutline" />

                <!-- Navigation Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatchTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/batch_timetable"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomTimetable"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/custom_timetable"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRosterSyncDrawer"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="⚡ Fast Roster Sync"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_orange_dark"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="@color/primary_orange"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncGoogleCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="Sync Google Calendar"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:icon="@drawable/ic_calendar"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconTint="@color/primary_orange"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />
<com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFacultyOffices"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/faculty_offices"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFreeRooms"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/free_rooms"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClashDetector"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/clash_detector"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_orange"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="@color/primary_orange"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMap"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/campus_map"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUserManual"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/user_manual"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutUs"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/about_us"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    app:cornerRadius="10dp"
                    app:backgroundTint="?attr/colorSurface"
                    app:strokeColor="?attr/colorOutline"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="@string/log_out"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/cancelled_color" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>

