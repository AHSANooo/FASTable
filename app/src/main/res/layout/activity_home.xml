<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home">

    <!-- Main content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F7FA">

    <!-- App Bar -->


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:background="#0D2A5C"
        android:elevation="4dp"
        android:paddingTop="30dp"
        android:paddingBottom="8dp"
        app:navigationIcon="@drawable/ic_menu"
        app:title="FASTable"
        app:titleCentered="true"
        app:titleTextColor="@android:color/white"
        app:menu="@menu/top_app_bar_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Tab Layout for Today/All Timetable -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabToday"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Today"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/selected_tab_left"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            app:elevation="0dp"
            app:strokeWidth="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabAllTimetable"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="All Timetable"
            android:textColor="#0A2E5D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/unselected_tab_right"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@null"
            app:elevation="0dp"
            app:strokeWidth="0dp" />
    </LinearLayout>

    <!-- Container for Today View -->
    <ScrollView
        android:id="@+id/scrollViewToday"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:scrollbars="none"
        android:fadeScrollbars="false"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Day Header -->
            <TextView
                android:id="@+id/tvCurrentDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Monday"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#0D2A5C"
                android:layout_marginBottom="16dp"
                android:fontFamily="sans-serif-medium" />

            <!-- RecyclerView for Today's Sessions -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDashboardSessions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No classes scheduled for today\n\nAdd courses from:\n• Batch Timetable\n• Custom Timetable"
                android:textSize="16sp"
                android:textColor="#666"
                android:textAlignment="center"
                android:padding="32dp"
                android:visibility="gone"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Container for All Timetable View -->
    <LinearLayout
        android:id="@+id/containerAllTimetable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Day Tabs for All Timetable -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            app:tabTextColor="#666"
            app:tabSelectedTextColor="#0A2E5D"
            app:tabIndicatorColor="#0A2E5D"
            app:tabMode="scrollable" />

        <!-- RecyclerView for All Timetable Sessions -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAllTimetable"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp"
            android:clipToPadding="false" />

        <!-- Empty State for All Timetable -->
        <TextView
            android:id="@+id/tvEmptyStateAll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="No classes scheduled\n\nAdd courses from:\n• Batch Timetable\n• Custom Timetable"
            android:textSize="16sp"
            android:textColor="#666"
            android:textAlignment="center"
            android:padding="32dp"
            android:gravity="center"
            android:visibility="gone"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTimetable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/add_timetable"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#0D2A5C"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF">

        <!-- Right-side shadow (fixed width + optional height percent if needed) -->
        <View
            android:id="@+id/rightShadow"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/right_side_shadow"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Top Bar Menu -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/top_bar_menu"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:background="@color/white"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:elevation="4dp"
            android:paddingTop="30dp"
            android:paddingBottom="8dp"
            app:navigationIcon="@drawable/ic_menu_black"
            app:titleTextColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Content Container (menu area ends at shadow start) -->
        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/top_bar_menu"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightShadow">

            <!-- Profile Section -->
            <LinearLayout
                android:id="@+id/profileSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profileImage"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_profile_placeholder"
                    app:civ_border_width="2dp"
                    app:civ_border_color="#E0E0E0"
                    android:contentDescription="@string/profile_image" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Muhammad Ahsan"
                        android:textColor="@color/navy"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="hmahsankhetran@gmail.com"
                        android:textColor="@color/navy"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgArrow"
                    android:layout_width="30dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#808080" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#B0B0B0" />

            <!-- Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatchTimetable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/batch_timetable"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomTimetable"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/custom_timetable"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacultyOffices"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/faculty_offices"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAboutUs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/about_us"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUserManual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="@string/user_manual"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/log_out"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0A2E5D"
                app:cornerRadius="10dp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#0A2E5D"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>
