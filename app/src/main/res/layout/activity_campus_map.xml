<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:paddingTop="28dp"
            android:paddingBottom="6dp"
            android:background="@color/top_bar_color"
            android:elevation="4dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:title="Live Campus Floor Map"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="?attr/homeAsUpIndicator" />

        <!-- Block Selector Segmented Buttons -->
        <LinearLayout
            android:id="@+id/blockSelectorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp"
            android:background="?android:attr/colorBackground">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleBlockGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlockA"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Block A"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:strokeColor="@color/primary_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlockB"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Block B"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:strokeColor="@color/primary_orange" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlockC"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Block C"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    app:strokeColor="@color/primary_orange" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Floor Selector Horizontal Chips -->
        <HorizontalScrollView
            android:id="@+id/scrollFloors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFloors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true" />
        </HorizontalScrollView>

        <!-- Live Status Legend Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="?attr/colorSurface">

            <!-- Green: Free -->
            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_dot_green" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:text="Free for Study"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Red: Occupied -->
            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_dot_red" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:text="Occupied"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Blue: Your Room -->
            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/bg_dot_blue" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="★ Your Room"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary_orange_dark" />
        </LinearLayout>

        <!-- Floor Plan Room List / Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFloorRooms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:clipToPadding="false" />

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
