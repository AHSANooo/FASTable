<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Room Name -->
        <TextView
            android:id="@+id/tvRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Room 101"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0A2E5D" />

        <!-- Free Time Slots -->
        <TextView
            android:id="@+id/tvFreeSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Free: 8:30 - 10:00, 1:00 - 2:30"
            android:textSize="14sp"
            android:textColor="@color/black"
            app:drawableStartCompat="@android:drawable/ic_menu_recent_history"
            android:drawablePadding="8dp"
            app:drawableTint="@android:color/darker_gray" />

        <!-- Room Type Indicator -->
        <TextView
            android:id="@+id/tvRoomType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Classroom"
            android:textSize="12sp"
            android:textColor="#666"
            android:background="@drawable/rounded_chip_background"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

